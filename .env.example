# Copy to .env.local and fill in. .env.local is git-ignored — never commit real passwords.

# --- Site address ---
# Leave empty until you buy a domain: on Vercel the *.vercel.app address is used automatically.
# After buying one, set it here (and in your host's env settings), e.g. NEXT_PUBLIC_SITE_URL=https://www.beenest.in
NEXT_PUBLIC_SITE_URL=

# --- Contact form email (SMTP) ---
# Gmail: SMTP_USER is your Gmail address; SMTP_PASS is a 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords), NOT your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=beenestech@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Inbox that receives new leads. Leave empty to use SMTP_USER; or write a full address, e.g. LEADS_TO=sales@yourdomain.com
LEADS_TO=

# Optional: different "from" address (Gmail only allows your own account or a verified alias)
SMTP_FROM=beenestech@gmail.com
